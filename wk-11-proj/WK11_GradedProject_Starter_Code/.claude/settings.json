{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npx vitest*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Bash(npm run populate*)"
    ],
    "defaultMode": "acceptEdits"
  }
}
